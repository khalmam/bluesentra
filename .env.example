# Copy to .env and adjust. Never commit real secrets (ADR-023).
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-every-environment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=bluesentra
POSTGRES_USER=bluesentra
POSTGRES_PASSWORD=bluesentra
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Explicit allowlist, never a wildcard with credentials (ADR-016)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Off by default; enabled only in the demo environment (ADR-014, ADR-023)
DEMO_MODE=false
